#!/usr/bin/env bash
set -euo pipefail
launcher_source="${BASH_SOURCE[0]}"
while [[ -L "$launcher_source" ]]; do
  launcher_dir="$(cd -P "$(dirname "$launcher_source")" && pwd)"
  launcher_source="$(readlink "$launcher_source")"
  [[ "$launcher_source" == /* ]] || launcher_source="$launcher_dir/$launcher_source"
done
WORKFLOW_ROOT="$(cd -P "$(dirname "$launcher_source")/.." && pwd)"
# shellcheck disable=SC1091
source "$WORKFLOW_ROOT/lib/workflow.sh"
WORKFLOW_DATA_ROOT="$(workflow_data_dir)"

for argument in "$@"; do
  case "$argument" in
    --effort|--effort=*|\
    --config|--config=*|\
    --plugin-dir|--plugin-dir=*|\
    --append-system-prompt|--append-system-prompt=*|\
    --append-system-prompt-file|--append-system-prompt-file=*|\
    --system-prompt|--system-prompt=*|\
    --system-prompt-file|--system-prompt-file=*|\
    --agent|--agent=*|\
    --settings|--settings=*|\
    --mcp-config|--mcp-config=*|\
    --strict-mcp-config|\
    --permission-mode|--permission-mode=*|\
    --dangerously-skip-permissions|\
    --allow-dangerously-skip-permissions)
      printf 'ERROR: claudex-gpt owns controller option: %s\n' "$argument" >&2
      exit 2
      ;;
  esac
done

while IFS= read -r inherited_claudex_variable; do
  unset "$inherited_claudex_variable"
done < <(compgen -A variable CLAUDEX_)
unset inherited_claudex_variable
CLAUDEX_CONFIG_FILE="$(model_config_file "$WORKFLOW_DATA_ROOT" claudex.toml)"

umask 077
if ! IFS=$'\t' read -r _CLIPROXY_PORT _HEADROOM_PORT CLAUDEX_PROXY_PORT \
    < <(read_service_ports "$WORKFLOW_DATA_ROOT" 2>/dev/null); then
  CLAUDEX_PROXY_PORT=13456
fi
proxy_not_ready() {
  printf 'ERROR: persistent Claudex proxy is not ready at 127.0.0.1:%s; run claudex-doctor\n' \
    "$CLAUDEX_PROXY_PORT" >&2
  exit 1
}
valid_service_port "$CLAUDEX_PROXY_PORT" || proxy_not_ready
case "$(uname -s)" in
  Darwin) proxy_platform=darwin ;;
  Linux) proxy_platform=systemd ;;
  *) proxy_not_ready ;;
esac
if ! IFS=$'\t' read -r \
    proxy_service_file proxy_service_label proxy_service_unit \
    < <(claudex_proxy_service_identity "$proxy_platform" 2>/dev/null); then
  proxy_not_ready
fi
claudex_proxy_service_is_owned \
  "$proxy_service_file" "$WORKFLOW_DATA_ROOT" \
  >/dev/null 2>&1 || proxy_not_ready
proxy_target_state="$(managed_service_target_state \
  "$proxy_platform" "$proxy_service_label" "$proxy_service_unit" \
  2>/dev/null)" || proxy_not_ready
[[ "$proxy_target_state" == loaded ]] || proxy_not_ready
proxy_loaded_definition="$(managed_service_definition_path \
  "$proxy_platform" "$proxy_service_label" "$proxy_service_unit" \
  2>/dev/null)" || proxy_not_ready
[[ "$proxy_loaded_definition" == "$proxy_service_file" ]] || proxy_not_ready
proxy_service_pid="$(managed_service_main_pid \
  "$proxy_platform" "$proxy_service_label" "$proxy_service_unit" \
  2>/dev/null)" || proxy_not_ready
pid_owns_loopback_listener \
  "$proxy_service_pid" "$CLAUDEX_PROXY_PORT" \
  >/dev/null 2>&1 || proxy_not_ready
controller_model="$(claudex_config_default_model \
  "$CLAUDEX_CONFIG_FILE" 2>/dev/null)" || proxy_not_ready
proxy_models_response="$(mktemp \
  "${TMPDIR:-/tmp}/claudex-launch-models.XXXXXX" 2>/dev/null)" || proxy_not_ready
cleanup_proxy_models() {
  rm -f -- "$proxy_models_response"
}
trap cleanup_proxy_models EXIT
if ! curl -fsS --connect-timeout 1 --max-time 2 \
    "http://127.0.0.1:$CLAUDEX_PROXY_PORT/v1/models" \
    >"$proxy_models_response" 2>/dev/null || \
   ! claudex_proxy_models_response_is_ready \
     "$proxy_models_response" "$controller_model"; then
  proxy_not_ready
fi
cleanup_proxy_models
trap - EXIT

launch_dir="$(physical_pwd)"
session_json="$({
  cd "$WORKFLOW_ROOT"
  python3 -m integrations.common.session_config create \
    --workflow-root "$WORKFLOW_ROOT" \
    --data-root "$WORKFLOW_DATA_ROOT" \
    --launch-dir "$launch_dir"
})"
if ! jq -e '
  type == "object" and
  (keys == ["contextFile", "contextSha256", "mcpFile", "runDir", "runId"]) and
  (.runId | type == "string" and startswith("run.")) and
  (.runDir | type == "string" and startswith("/")) and
  (.contextFile | type == "string" and startswith("/")) and
  (.contextSha256 | type == "string" and test("^[0-9a-f]{64}$")) and
  (.mcpFile | type == "string" and startswith("/")) and
  (.contextFile == (.runDir + "/context.json")) and
  (.mcpFile == (.runDir + "/mcp.json")) and
  (.runId == (.runDir | split("/") | last))
' <<<"$session_json" >/dev/null; then
  printf 'ERROR: invalid owned session metadata\n' >&2
  exit 1
fi
session_run_dir="$(jq -er '.runDir' <<<"$session_json")"
session_mcp_config="$(jq -er '.mcpFile' <<<"$session_json")"
session_context_sha256="$(jq -er '.contextSha256' <<<"$session_json")"
assert_owned_session "$WORKFLOW_ROOT" "$WORKFLOW_DATA_ROOT" "$session_run_dir" "$session_context_sha256"

export CLAUDEX_MCP_CONFIG="$session_mcp_config"
CLAUDEX_RUN_DIR="$(dirname "$session_mcp_config")"
export CLAUDEX_RUN_DIR
export CLAUDEX_CONTEXT_FILE="$CLAUDEX_RUN_DIR/context.json"
export CLAUDEX_CONTEXT_SHA256="$session_context_sha256"
CLAUDEX_RUN_ID="$(basename "$CLAUDEX_RUN_DIR")"
export CLAUDEX_RUN_ID
export CLAUDEX_WORKFLOW_ROOT="$WORKFLOW_ROOT"
export CLAUDEX_DATA_DIR="$WORKFLOW_DATA_ROOT"

if ! python3 "$WORKFLOW_ROOT/controller/plugin/scripts/ensure-graphify-hook.py"; then
  printf 'WARN: Graphify Git hook could not be verified; session will continue with the existing graph.\n' >&2
fi

export CLAUDE_CONFIG_DIR="$WORKFLOW_DATA_ROOT/claude-config"
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=3
export CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION=24
export CLAUDE_CODE_MAX_RETRIES=2
export ENABLE_TOOL_SEARCH=true
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1
export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
unset CLAUDE_CODE_SUBAGENT_MODEL
unset CLAUDE_CODE_DISABLE_WORKFLOWS
unset CLAUDE_CODE_EFFORT_LEVEL

exec "$WORKFLOW_DATA_ROOT/bin/claudex" \
  --config "$CLAUDEX_CONFIG_FILE" \
  run gpt \
  --mcp-config "$CLAUDEX_MCP_CONFIG" \
  --strict-mcp-config \
  --effort high \
  --append-system-prompt-file "$WORKFLOW_ROOT/controller/controller-policy.md" \
  --plugin-dir "$WORKFLOW_ROOT/controller/plugin" \
  "$@"
