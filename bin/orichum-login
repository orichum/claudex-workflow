#!/usr/bin/env bash
set -euo pipefail
launcher_source="${BASH_SOURCE[0]}"
while [[ -L "$launcher_source" ]]; do
  launcher_dir="$(cd -P "$(dirname "$launcher_source")" && pwd)"
  launcher_source="$(readlink "$launcher_source")"
  [[ "$launcher_source" == /* ]] || launcher_source="$launcher_dir/$launcher_source"
done
WORKFLOW_ROOT="$(cd -P "$(dirname "$launcher_source")/.." && pwd)"
# shellcheck source=../lib/workflow.sh
# shellcheck disable=SC1091
source "$WORKFLOW_ROOT/lib/workflow.sh"
WORKFLOW_DATA_ROOT="$(workflow_data_dir)"
ORICHUM_PYTHON="$(resolve_orichum_python "$WORKFLOW_DATA_ROOT")"
export ORICHUM_PYTHON
ORICHUM_PYTHON_VALIDATED="$ORICHUM_PYTHON"
export ORICHUM_PYTHON_VALIDATED

if [[ "$#" -eq 0 || "$1" == -* ]]; then
  workflow_die "usage: orichum provider login <installed-oauth-provider> [arguments...]"
  exit 2
fi
provider="$1"
shift
proxy_binary="$WORKFLOW_DATA_ROOT/bin/cli-proxy-api"
login_flag="$(login_flag_for_provider "$proxy_binary" "$provider")"
arguments=(
  "$proxy_binary"
  --config "$WORKFLOW_DATA_ROOT/cliproxy.yaml"
  "$login_flag"
  "$@"
)

umask 077
set +e
"${arguments[@]}"
login_status=$?
find "$WORKFLOW_DATA_ROOT/auth" -maxdepth 1 -type f -exec chmod 0600 {} \;
if [[ "$login_status" -eq 0 ]]; then
  if ! (
    cd "$WORKFLOW_ROOT"
    "$ORICHUM_PYTHON" -B -m integrations.common.provider_credentials \
      --auth-dir "$WORKFLOW_DATA_ROOT/auth" default-for "$provider"
  ); then
    workflow_die \
      "authentication succeeded, but the provider routing priority was not applied"
    exit 1
  fi
  printf 'Authentication complete. Next: orichum provider account add ...; orichum models validate\n'
fi
exit "$login_status"
