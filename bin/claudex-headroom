#!/usr/bin/env bash
set -euo pipefail
launcher_source="${BASH_SOURCE[0]}"
while [[ -L "$launcher_source" ]]; do
  launcher_dir="$(cd -P "$(dirname "$launcher_source")" && pwd)"
  launcher_source="$(readlink "$launcher_source")"
  [[ "$launcher_source" == /* ]] || launcher_source="$launcher_dir/$launcher_source"
done
WORKFLOW_ROOT="$(cd -P "$(dirname "$launcher_source")/.." && pwd)"
# shellcheck source=../lib/workflow.sh
source "$WORKFLOW_ROOT/lib/workflow.sh"
WORKFLOW_DATA_ROOT="$(workflow_data_dir)"
HEADROOM_BIN="$WORKFLOW_DATA_ROOT/headroom/bin/headroom"
if [[ ! -x "$HEADROOM_BIN" ]]; then
  printf 'ERROR: workflow Headroom is not installed; run ./install.sh\n' >&2
  exit 1
fi
export HEADROOM_CONFIG_DIR="$WORKFLOW_DATA_ROOT/headroom/config"
export HEADROOM_WORKSPACE_DIR="$WORKFLOW_DATA_ROOT/headroom/state"
unset HEADROOM_SAVINGS_PATH HEADROOM_SAVINGS_EVENTS_PATH HEADROOM_TOIN_PATH \
  HEADROOM_SUBSCRIPTION_STATE_PATH HEADROOM_SETTINGS_PATH
exec "$HEADROOM_BIN" "$@"
